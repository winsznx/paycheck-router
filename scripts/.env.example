# Environment for pnpm demo:fork, pnpm test:fork and scripts/lib/fork.ts. Copy the values into
# your shell; nothing here is read from this file automatically.

# Fork-only keypairs (program-id, deployer, admin, crank, ...). Defaults to internal/keys.
PAYCHECK_ROUTER_KEYS_DIR=

# The program binary to deploy under the production program id, and where it came from.
PROGRAM_SO=target/deploy/paycheck_router.so
PROGRAM_SOURCE=

# Pyth Hermes needs an API key (bearer token) for price updates.
PYTH_API_KEY=
HERMES_URL=https://hermes.pyth.network

# Optional: Jupiter key for /swap/v2/build.
JUPITER_API_KEY=

# Optional: the mainnet source the surfnet forks from. SURFNET_DATASOURCE_URL wins over
# HELIUS_API_KEY; with neither, the public mainnet-beta RPC is used.
SURFNET_DATASOURCE_URL=
HELIUS_API_KEY=

# Optional: surfnet RPC ports. demo:fork uses 8899 when free, else the next free port.
FORK_RPC_PORT=
FORK_TEST_RPC_PORT=

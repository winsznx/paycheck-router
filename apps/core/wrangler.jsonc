        "SIWS_DOMAIN": "paycheck-router-demo.timjosh507.workers.dev",
        "RESEND_FROM": "",
        "TELEGRAM_BOT_USERNAME": ""
      }
    },
    // The public site's API: live mainnet prices, /proof from the committed fork bundle, /status.
    // No surfnet, no crank, sponsor or recorder keys, no queues, no crons; the database joins
    // through Hyperdrive once the Supabase project exists (until then its routes answer 503).
    "public": {

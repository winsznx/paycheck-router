        ],
        "consumers": [
          {
            "queue": "inflows",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "max_concurrency": 4,
            "dead_letter_queue": "inflows-dlq"
          },
          {
            "queue": "executions",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 4,
            "dead_letter_queue": "executions-dlq"
          },
          {
            "queue": "verify",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 10,
            "max_concurrency": 2,
            "dead_letter_queue": "verify-dlq"
          },
          {
            "queue": "notify",
            "max_batch_size": 25,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "max_concurrency": 2,

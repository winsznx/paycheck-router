        "CORS_ORIGINS": "http://127.0.0.1:3000",
        "RESEND_FROM": "",
        "TELEGRAM_BOT_USERNAME": ""
      }
    },
    // The public hosted demo: the full pipeline against a Surfpool fork of mainnet on a VPS that
    // restores its snapshot every RESET_EVERY_HOURS. Every request to the fork carries the
    // X-Surfnet-Key header (secret SURFNET_RPC_KEY). Fork-only role keys; no KV, so no crank
    // pause switch. Its own queues, database (Hyperdrive) and rate-limit namespaces.
    "hosted": {
      "name": "paycheck-router-demo-core",
      "migrations": [
        {
          "tag": "init",
          "new_sqlite_classes": ["RouterActor", "UserHub", "InflowWatcher", "RateGate"]
        },
        { "tag": "mark-book", "new_sqlite_classes": ["MarkBook"] }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "ROUTER_ACTOR", "class_name": "RouterActor" },
          { "name": "USER_HUB", "class_name": "UserHub" },
          { "name": "INFLOW_WATCHER", "class_name": "InflowWatcher" },
          { "name": "RATE_GATE", "class_name": "RateGate" },
          { "name": "MARK_BOOK", "class_name": "MarkBook" }
        ]
      },
      "queues": {
        "producers": [
          { "binding": "INFLOWS", "queue": "demo-inflows" },
          { "binding": "EXECUTIONS", "queue": "demo-executions" },
          { "binding": "VERIFY", "queue": "demo-verify" },
          { "binding": "NOTIFY", "queue": "demo-notify" }
        ],
        "consumers": [
          {
            "queue": "demo-inflows",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "max_concurrency": 4,
            "dead_letter_queue": "demo-inflows-dlq"
          },
          {
            "queue": "demo-executions",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 4,
            "dead_letter_queue": "demo-executions-dlq"
          },
          {
            "queue": "demo-verify",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 10,
            "max_concurrency": 2,
            "dead_letter_queue": "demo-verify-dlq"
          },
          {
            "queue": "demo-notify",
            "max_batch_size": 25,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "max_concurrency": 2,
            "dead_letter_queue": "demo-notify-dlq"
          },
          { "queue": "demo-inflows-dlq", "max_batch_size": 10, "max_retries": 0 },
          { "queue": "demo-executions-dlq", "max_batch_size": 10, "max_retries": 0 },
          { "queue": "demo-verify-dlq", "max_batch_size": 10, "max_retries": 0 },
          { "queue": "demo-notify-dlq", "max_batch_size": 10, "max_retries": 0 }
        ]
      },
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "paycheck_metrics_demo" }],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "27a53dc653564cb7b1ff7e7a77fb7945" }],
      "ratelimits": [
        {
          "name": "USER_LIMITER",
          "namespace_id": "5001",
          "simple": { "limit": 120, "period": 60 }
        },
        { "name": "TX_LIMITER", "namespace_id": "5002", "simple": { "limit": 20, "period": 60 } },
        {
          "name": "QUOTE_LIMITER",
          "namespace_id": "5003",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "PUBLIC_LIMITER",
          "namespace_id": "5004",
          "simple": { "limit": 60, "period": 60 }
        },
        { "name": "AUTH_LIMITER", "namespace_id": "5005", "simple": { "limit": 20, "period": 60 } },
        {
          "name": "PARTNER_LIMITER",
          "namespace_id": "5006",
          "simple": { "limit": 600, "period": 60 }
        },
        { "name": "DEMO_LIMITER", "namespace_id": "5007", "simple": { "limit": 30, "period": 60 } }
      ],

          { "name": "USER_HUB", "class_name": "UserHub" },
          { "name": "INFLOW_WATCHER", "class_name": "InflowWatcher" },
          { "name": "RATE_GATE", "class_name": "RateGate" },
          { "name": "MARK_BOOK", "class_name": "MarkBook" }
        ]
      },
      "queues": {
        "producers": [
          { "binding": "INFLOWS", "queue": "inflows" },
          { "binding": "EXECUTIONS", "queue": "executions" },
          { "binding": "VERIFY", "queue": "verify" },
          { "binding": "NOTIFY", "queue": "notify" }
        ],
        "consumers": [
          {
            "queue": "inflows",
            "max_batch_size": 10,
            "max_retries": 5,
            "max_concurrency": 4,
            "dead_letter_queue": "inflows-dlq"
          },
          {
            "queue": "executions",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 4,
            "dead_letter_queue": "executions-dlq"
          },
          {
            "queue": "verify",
            "max_batch_size": 10,
            "max_retries": 10,
            "max_concurrency": 2,
            "dead_letter_queue": "verify-dlq"
          },
          {
            "queue": "notify",
            "max_batch_size": 25,
            "max_retries": 5,
            "max_concurrency": 2,
            "dead_letter_queue": "notify-dlq"
          },
          { "queue": "inflows-dlq", "max_batch_size": 10, "max_retries": 0 },
          { "queue": "executions-dlq", "max_batch_size": 10, "max_retries": 0 },
          { "queue": "verify-dlq", "max_batch_size": 10, "max_retries": 0 },
          { "queue": "notify-dlq", "max_batch_size": 10, "max_retries": 0 }
        ]
      },
      // Resource IDs are filled in when the production resources are created at deploy time.
      "kv_namespaces": [{ "binding": "REGISTRY", "id": "00000000000000000000000000000000" }],
      "r2_buckets": [
        { "binding": "EVIDENCE", "bucket_name": "paycheck-evidence" },
        { "binding": "EXPORTS", "bucket_name": "paycheck-exports" }
      ],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "paycheck_metrics" }],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
      "ratelimits": [
        {
          "name": "USER_LIMITER",
          "namespace_id": "3001",
          "simple": { "limit": 120, "period": 60 }
        },
        { "name": "TX_LIMITER", "namespace_id": "3002", "simple": { "limit": 20, "period": 60 } },
        {
          "name": "QUOTE_LIMITER",
          "namespace_id": "3003",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "PUBLIC_LIMITER",
          "namespace_id": "3004",
          "simple": { "limit": 60, "period": 60 }
        },
        { "name": "AUTH_LIMITER", "namespace_id": "3005", "simple": { "limit": 20, "period": 60 } },
        {
          "name": "PARTNER_LIMITER",
          "namespace_id": "3006",
          "simple": { "limit": 600, "period": 60 }
        }
      ],

          },
          { "queue": "inflows-dlq", "max_batch_size": 10, "max_retries": 0 },
          { "queue": "executions-dlq", "max_batch_size": 10, "max_retries": 0 },
          { "queue": "verify-dlq", "max_batch_size": 10, "max_retries": 0 },
          { "queue": "notify-dlq", "max_batch_size": 10, "max_retries": 0 }
        ]
      },
      "kv_namespaces": [{ "binding": "REGISTRY", "id": "demo-registry" }],
      "r2_buckets": [
        { "binding": "EVIDENCE", "bucket_name": "paycheck-evidence" },
        { "binding": "EXPORTS", "bucket_name": "paycheck-exports" }
      ],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "paycheck_metrics" }],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "demo-hyperdrive",
          "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres"
        }
      ],
      "ratelimits": [
        {
          "name": "USER_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 120, "period": 60 }
        },
        { "name": "TX_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
        {
          "name": "QUOTE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "PUBLIC_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 60, "period": 60 }
        },
        { "name": "AUTH_LIMITER", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
        {
          "name": "PARTNER_LIMITER",
          "namespace_id": "1006",
          "simple": { "limit": 600, "period": 60 }
        },
        { "name": "DEMO_LIMITER", "namespace_id": "1007", "simple": { "limit": 30, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "demo",
        "PROGRAM_ID": "PayEFo1ZAPXKf5H4DoqrsEceYzdSvXJBAGBD7AMQY6H",
        "USDC_MINT": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
        "CONFIG_PDA": "",
        "PROTOCOL_ALT": "",
        "SURFNET_RPC_URL": "http://127.0.0.1:8899",
        "HELIUS_RPC_URL": "",
        "ALCHEMY_RPC_URL": "",
        "HERMES_URL": "https://hermes.pyth.network",
        "JUPITER_BASE_URL": "https://api.jup.ag",

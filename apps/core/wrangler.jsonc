        { "name": "TX_LIMITER", "namespace_id": "4002", "simple": { "limit": 20, "period": 60 } },
        {
          "name": "QUOTE_LIMITER",
          "namespace_id": "4003",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "PUBLIC_LIMITER",
          "namespace_id": "4004",
          "simple": { "limit": 60, "period": 60 }
        },
        { "name": "AUTH_LIMITER", "namespace_id": "4005", "simple": { "limit": 20, "period": 60 } },
        {

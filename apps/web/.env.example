# apps/web environment contract. Copy to .env.local for `pnpm --filter @paycheck-router/web dev`.
# NEXT_PUBLIC_* values are inlined at build time.

# local | demo | staging | production. `demo` shows the fork banner and registers the demo signer.
NEXT_PUBLIC_ENVIRONMENT=local

# Core API base URL (apps/core under `wrangler dev`).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# Surfnet RPC for explorer links (cluster=custom&customUrl=...). Fork environments only.
NEXT_PUBLIC_SURFNET_RPC_URL=http://127.0.0.1:8899

# Canonical site URL for metadata and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" once the program is live on mainnet; until then public pages carry the fork label
# and Start opens the waitlist.
NEXT_PUBLIC_MAINNET_DEPLOYED=false

# Cloudflare Turnstile site key for the waitlist and partner forms (public).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFDQGy1MnmLBUS_3

# Demo only: the fork-only demo-worker secret key (base58, 64 bytes), injected by
# `pnpm demo:record` into a gitignored .env.local. Served to the browser only by
# /api/demo-signer when NEXT_PUBLIC_ENVIRONMENT=demo; any other build fails if it is set.
# DEMO_SIGNER_SECRET=

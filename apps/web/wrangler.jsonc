{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "paycheck-router",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "paycheck-router"
    }
  ],
  "observability": {
    "enabled": true
  },
  // The public demo on the hosted fork: pnpm --filter @paycheck-router/web run deploy:hosted-demo
  "env": {
    "hosted-demo": {
      "name": "paycheck-router-demo",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "paycheck-router-demo"
        }
      ]
    }
  }
}

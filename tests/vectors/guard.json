{
  "version": 1,
  "description": "Golden vectors for the PRD 6.6 guard math. Integers are decimal strings; multipliers are the f64 read from the mint's ScaledUiAmount extension, written as the shortest round-trip decimal.",
  "conventions": {
    "price_e9": "Price in USD per UI unit, fixed point at 1e9.",
    "multiplier": "Parsed as an IEEE 754 double and converted once to fixed point at 1e12 by truncation: trunc(m * 1e12), Rust `(m * 1e12) as u128`, JS BigInt(Math.trunc(m * 1e12)).",
    "multiplier_invalid": "The program rejects a non-finite multiplier, one <= 0, or one that truncates to 0 as MathOverflow; no vector uses such a value.",
    "buy": "floor((usdc_in * usdc_price_e9 * 10^decimals * 10^4 * 10^6) / (price_e9 * (10^4 + band_bps) * m_e12))",
    "sell": "floor((amount_in * m_e12 * price_e9 * (10^4 - band_bps)) / (10^decimals * usdc_price_e9 * 10^4 * 10^6))",
    "convert": "floor((amount_in * m_pre_e12 * ratio_num * (10^4 - band_bps) * 10^decimals_target) / (10^decimals_pre * ratio_den * 10^4 * m_target_e12))",
    "overflow": "Numerator and denominator are u128 products checked after each factor, left to right in the order written above; any partial product above 2^128 - 1 or a zero denominator yields MathOverflow. The program also rejects a quotient above 2^64 - 1; no vector reaches that case without a u128 overflow.",
    "ranges": "decimals 0..=18; band_bps up to 9999 for sell and convert; amounts fit u64."
  },
